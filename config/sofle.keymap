 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 *
 * Sofle Choc keymap modelled on a Dygma Defy (Bazecor) config.
 *
 *   Defy L1 -> BASE, Defy L2 -> NAV, Defy L3 -> FN.
 *   CONTROLS (Bluetooth, ext power, ZMK Studio unlock) is reached as on the stock
 *   Sofle: have FN and NAV active together (hold Fn on the left thumb, tap Nav on
 *   the right thumb).
 *
 * The Defy has an extra inner column and 8 thumb keys per side; the Sofle doesn't.
 * Where a Defy key had no home it was moved; see the comments on each layer.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV 1
#define FN 2
#define CONTROLS 3
#define EXTRA 4

// Defy qukeys hold timeout was 250 ms. "balanced" avoids Ctrl/Alt firing when
// rolling quickly off Enter/Delete into the next key.
&mt {
    flavor = "balanced";
    tapping-term-ms = <250>;
    quick-tap-ms = <175>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        controls_layer {
            if-layers = <NAV FN>;
            then-layer = <CONTROLS>;
        };
    };

    // Stock Sofle combos, kept unchanged.
    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <32 31>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <27 33>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <25 41>;
        };
    };

    behaviors {
        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <POUND MINUS BACKSPACE UNDERSCORE>;
        };

        clip_ht: clip_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&kp>;
        };

        // Defy Superkey 0, adapted for macOS: tap = Cmd+C, hold = Cmd+V,
        // tap-then-hold = Cmd+Shift+V, double-tap = Cmd+X.
        clip: clipboard_superkey {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&clip_ht LG(V) LG(C)>, <&clip_ht LG(LS(V)) LG(X)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "base";

            // ---------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3  |  4  |  5  |                      |  6  |  7  |  8  |  9  |  0  |  -    |
            // |  ESC  |  Q  |  W  |  E  |  R  |  T  |                      |  Y  |  U  |  I  |  O  |  P  |  [    |
            // |  BSPC |  A  |  S  |  D  |  F  |  G  |                      |  H  |  J  |  K  |  L  |  ;  |  '    |
            // |  SHFT |  Z  |  X  |  C  |  V  |  B  |  =   |      |   ]    |  N  |  M  |  ,  |  .  |  /  |  SHFT |
            //         | GUI | ALT/ENT | CTL/DEL | FN | SPC |      | SPC | NAV(1-shot) | CTL/ENT | TAB | GUI |
            //
            // Defy inner-column keys "=" and "]" moved to the two inner bottom keys.
            // Defy "\" (right inner, home row) moved to FN + ' (see FN layer).
            // Defy thumbs dropped: left Tab, right RAlt, clipboard superkey (now on NAV),
            // LED-next, and the two Defy wireless keys.

            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                         &kp N6  &kp N7     &kp N8     &kp N9   &kp N0    &kp MINUS
&kp ESC     &kp Q   &kp W   &kp E   &kp R   &kp T                                          &kp Y   &kp U      &kp I      &kp O    &kp P     &kp LBKT
&kp BSPC    &kp A   &kp S   &kp D   &kp F   &kp G                                          &kp H   &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT   &kp Z   &kp X   &kp C   &kp V   &kp B   &kp EQUAL                   &kp RBKT   &kp N   &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                    &kp LGUI  &mt LALT ENTER  &mt LCTRL DEL  &mo FN  &kp SPACE   &kp SPACE  &sl NAV  &mt RCTRL ENTER  &kp TAB  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            display-name = "nav";

            // Defy L2, one-shot from the right thumb.
            // ---------------------------------------------------------------------------------------------------
            // |  ESC  |      |      |      |       |      |                   | NUMLK |     |  /  |  *  |  =  | BSPC |
            // |  TAB  |      | HOME |  UP  |  END  | PGUP |                   |       |  7  |  8  |  9  |  -  |      |
            // |       | PSCR | LEFT | DOWN | RIGHT | PGDN |                   |       |  4  |  5  |  6  |  +  |      |
            // |  SHFT |      |      |      |       |      |     |      |      |   .   |  1  |  2  |  3  | ENT |      |
            //         |  ▽   |  ▽   |  ▽   |  ▽    |  ▽   |      |  0   |  ▽  |     |     | CLIP |
            //
            // Left thumbs stay transparent so GUI/Alt/Ctrl work with arrows (as on the Defy).
            // CLIP = Defy clipboard superkey (moved here, no room on the base thumbs).

            bindings = <
&kp ESC    &none      &none     &none     &none      &none                         &kp KP_NUMLOCK &none     &kp KP_SLASH  &kp KP_MULTIPLY  &kp EQUAL     &kp BSPC
&kp TAB    &none      &kp HOME  &kp UP    &kp END    &kp PG_UP                     &none        &kp KP_N7 &kp KP_N8     &kp KP_N9        &kp KP_MINUS  &none
&none      &kp PSCRN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN                     &none        &kp KP_N4 &kp KP_N5     &kp KP_N6        &kp KP_PLUS   &none
&kp LSHFT  &none      &none     &none     &none      &none      &none   &none      &kp KP_DOT   &kp KP_N1 &kp KP_N2     &kp KP_N3        &kp KP_ENTER  &none
                      &trans    &trans    &trans     &trans     &trans  &kp KP_N0  &trans       &none     &none         &clip
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        fn_layer {
            display-name = "fn";

            // Defy L3, held on the left thumb.
            // ---------------------------------------------------------------------------------------------------
            // |   `   |  F1  |  F2  |  F3  |  F4  |  F5  |                    |  F8  |  F9  | F10  | F11  | F12 |     |
            // |       |      |      | PREV | NEXT | VOL+ |                    |      | BRI+ |      |      |  ▽  |     |
            // |       |      | EJCT | STOP | PLAY | VOL- |                    |      | BRI- | SLEEP| POWER|     |  \  |
            // |       |      |      |      |      | MUTE |  F6  |     |  F7   |      |      |      |      |     |     |
            //         |      |      |      |  ▽   |      |      |     |      |  ▽   |      |      |      |
            //
            // F8-F12 keep their Defy positions; Defy inner-column F6/F7 moved to the inner bottom keys.
            // NAV thumb is transparent so Fn + Nav reaches the CONTROLS layer.

            bindings = <
&kp GRAVE  &kp F1  &kp F2       &kp F3      &kp F4      &kp F5                               &kp F8  &kp F9        &kp F10      &kp F11      &kp F12  &none
&none      &none   &none        &kp C_PREV  &kp C_NEXT  &kp C_VOL_UP                         &none   &kp C_BRI_UP  &none        &none        &trans   &none
&none      &none   &kp C_EJECT  &kp C_STOP  &kp C_PP    &kp C_VOL_DN                         &none   &kp C_BRI_DN  &kp C_SLEEP  &kp C_POWER  &none    &kp BSLH
&none      &none   &none        &none       &none       &kp C_MUTE    &kp F6       &kp F7    &none   &none         &none        &none        &none    &none
                   &none        &none       &none       &trans        &none        &none     &trans  &none         &none        &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        controls_layer {
            display-name = "controls";

            // Stock Sofle "adjust" layer, unchanged: Bluetooth, external power, ZMK Studio unlock, caps word.
            // ----------------------------------------------------------------------------------------------------------
            // | BTCLR  | BT1 | BT2 | BT3 | BT4 | BT5           |                  |  |  |  |  |  |  |
            // | EXTPWR |     |     |     |     | STUDIO UNLOCK |                  |  |  |  |  |  |  |
            // |        |     |     |     |     |               |                  |  |  |  |  |  |  |
            // |        |     |     |     |     | CAPS WORD     |       |  |       |  |  |  |  |  |  |

            bindings = <
&bt BT_CLR_ALL     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &none         &none         &none         &none         &studio_unlock                       &none  &none  &none  &none  &none  &none
&none              &none         &none         &none         &none         &none                                &none  &none  &none  &none  &none  &none
&none              &none         &none         &none         &none         &caps_word      &none         &none  &none  &none  &none  &none  &none  &none
                                 &none         &none         &none         &none           &none         &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        extra_layer {
            display-name = "extra1";

            // Stock spare layer, unchanged (handy for live edits in ZMK Studio).
            bindings = <
&none  &none  &none  &none  &none  &none                                  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &studio_unlock                         &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                                  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &caps_word      &none  &none           &none  &none  &none  &none  &none  &none
              &none  &none  &none  &none           &none  &none           &none  &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
